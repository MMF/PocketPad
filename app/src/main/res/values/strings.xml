    <!-- Onboarding -->
    <string name="onboarding_title_welcome">Welcome</string>
    <string name="onboarding_body_welcome">Mobile TrackPad turns this phone into a Bluetooth mouse for your computer. The computer needs no extra software.\n\nIt works as a standard mouse and keyboard. Pinch, rotate and three-finger gestures are sent as keyboard shortcuts, so they are not the same as your computer’s own trackpad gestures, and what a shortcut does depends on the computer and the app.</string>
    <string name="onboarding_title_permissions">Permissions</string>
    <string name="onboarding_body_permissions">The app needs the Nearby devices permission to act as a Bluetooth mouse and to make the phone visible while you pair. Notifications are optional: they show a Stop button while the trackpad is on. The app has no internet access.</string>
    <string name="onboarding_permissions_granted">Nearby devices permission granted.</string>
    <string name="onboarding_title_check">Compatibility check</string>
    <string name="onboarding_body_check">This checks that Bluetooth and Android’s Bluetooth HID device service are available. It cannot prove that a particular computer will accept the phone; only pairing can.</string>
    <string name="onboarding_run_check">Run check</string>
    <string name="check_adapter">Bluetooth hardware</string>
    <string name="check_enabled">Bluetooth turned on</string>
    <string name="check_permission">Nearby devices permission</string>
    <string name="check_profile">Bluetooth HID device service</string>
    <string name="check_ok">OK</string>
    <string name="check_failed">Not available</string>
    <string name="check_pending">Checking…</string>
    <string name="check_skipped">Not checked</string>
    <string name="onboarding_title_pairing">Pairing order</string>
    <string name="onboarding_body_pairing">Order matters: computers remember what a device offered when they paired.\n\n1. On the main screen, tap Enable trackpad first.\n2. Tap Make phone visible for pairing.\n3. Pair from the computer’s Bluetooth settings.\n4. Choose a shortcut profile for that computer, then tap Connect.\n\nIf this phone was already paired with the computer, remove the pairing on both the phone and the computer, then pair again in this order.\n\nTap Stop before turning Bluetooth off. On some phones, turning Bluetooth off while the trackpad is on means the phone must be restarted before it works again.</string>

