    <string name="permission_heading">Permission needed</string>
    <string name="permission_rationale">To act as a Bluetooth mouse, Mobile TrackPad needs the Nearby devices permission. It is used only to talk to computers you pair with and to make the phone visible during pairing. Notifications are optional: they show a Stop button while the trackpad is active.</string>

    <string name="pairing_steps">1. Keep this screen open with the trackpad enabled.\n2. Tap “Make phone visible for pairing”.\n3. On the computer, open Bluetooth settings and add a new device. Choose this phone.\n4. Confirm the pairing code on both devices if asked.\n\nPair only after enabling the trackpad. If this phone was paired with the computer before, remove the pairing on both the phone and the computer first, then pair again.</string>

    <string name="hosts_empty">No paired devices. Pair the phone from the computer’s Bluetooth settings.</string>
    <string name="hosts_need_permission">Grant the Nearby devices permission to see paired devices.</string>
    <string name="host_flag_maybe_repair">Paired before the trackpad was enabled. If connecting fails, remove the pairing on both devices and pair again.</string>
    <string name="host_flag_needs_repair">This computer removed the trackpad. Remove the pairing on both devices and pair again.</string>
    <string name="host_flag_not_computer">Not identified as a computer.</string>
    <string name="host_last">Last used</string>

    <!-- Problems: title and explanation -->
    <string name="problem_bluetooth_unavailable_title">Bluetooth not available</string>
    <string name="problem_bluetooth_unavailable_body">This phone does not report a Bluetooth adapter.</string>
    <string name="problem_bluetooth_disabled_title">Bluetooth is off</string>
    <string name="problem_bluetooth_disabled_body">Turn on Bluetooth, then enable the trackpad again.</string>
    <string name="problem_bluetooth_turned_off_title">Bluetooth was turned off</string>
    <string name="problem_bluetooth_turned_off_body">Bluetooth was turned off while the trackpad was enabled, so the session ended. On some phones this stops the trackpad from registering again until the phone restarts. If enabling fails after you turn Bluetooth back on, restart the phone. Next time, tap Stop before turning Bluetooth off.</string>
    <string name="problem_missing_permissions_title">Permission missing</string>
    <string name="problem_missing_permissions_body">The Nearby devices permission was not granted. Without it the app cannot act as a Bluetooth mouse.</string>
    <string name="problem_service_blocked_title">Could not start</string>
    <string name="problem_service_blocked_body">Android did not allow the trackpad to start its background service. Open the app and tap Enable again.</string>
    <string name="problem_profile_unavailable_title">Bluetooth HID device mode unavailable</string>
    <string name="problem_profile_unavailable_body">Android did not provide its Bluetooth HID device service. Some phone manufacturers disable this feature. Try turning Bluetooth off and on, then try again. If it keeps failing, this phone may not support acting as a Bluetooth mouse.</string>
    <string name="problem_registration_rejected_title">Registration rejected</string>
    <string name="problem_registration_rejected_body">Android refused to register the trackpad. Another app may currently be acting as a Bluetooth keyboard or mouse; close it and try again. Registration also fails if the app is not in the foreground.</string>
    <string name="problem_registration_stalled_title">Registration did not complete</string>
    <string name="problem_registration_stalled_body">Android accepted the request but never finished registering the trackpad. On some phones this happens after Bluetooth was turned off while the trackpad was enabled, and it lasts until the phone restarts. Restart the phone, then enable the trackpad again. While in this state the phone may also fail to connect to its own Bluetooth mice and keyboards.</string>
    <string name="problem_registration_lost_title">Trackpad was unregistered</string>
    <string name="problem_registration_lost_body">Android ended the trackpad registration, for example because Bluetooth restarted or the app lost foreground priority. Enable it again.</string>
    <string name="problem_connection_failed_title">Connection failed</string>
    <string name="problem_connection_failed_body">The computer did not accept the connection. Check that its Bluetooth is on and it is in range. If it was paired before the trackpad was enabled, remove the pairing on both devices and pair again.</string>
    <string name="problem_connection_timeout_title">Connection timed out</string>
    <string name="problem_connection_timeout_body">The computer did not respond in time. Check that it is awake, in range and has Bluetooth on, then try again.</string>
    <string name="problem_connection_lost_title">Connection lost</string>
    <string name="problem_connection_lost_body">The connection to the computer dropped. Held buttons were released on the phone. Connect again when ready.</string>
    <string name="problem_host_unplugged_title">Computer removed the trackpad</string>
    <string name="problem_host_unplugged_body">The computer ended the virtual cable, which usually means it removed this device. Remove the pairing on the phone too, then pair again. The app will not reconnect automatically.</string>
    <string name="problem_detail">Technical detail: %1$s</string>

